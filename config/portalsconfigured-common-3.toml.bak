#Portals Configured - Common Configuration
[portal]
	#The block used to build nether portal frames.
	#Use the full registry name, e.g. 'kubejs:infused_obsidian' or 'minecraft:obsidian'.
	#Defaults to vanilla obsidian (no change to normal behaviour).
	portalFrameBlock = "minecraft:obsidian",
	"minecraft:crying_obsidian",
	"nether_portal_remastered:obsidian_rune_bolt",
	"nether_portal_remastered:obsidian_rune_vex",
	"nether_portal_remastered:obsidian_rune_flow",
	"nether_portal_remastered:obsidian_rune_wild",
	"nether_portal_remastered:obsidian_rune_dune",
	"nether_portal_remastered:obsidian_rune_coast",
	"nether_portal_remastered:obsidian_rune_eye",
	"nether_portal_remastered:obsidian_rune_wayfinder",
	"nether_portal_remastered:obsidian_rune_raiser",
	"nether_portal_remastered:obsidian_rune_ward",
	"nether_portal_remastered:obsidian_rune_tide",
	"nether_portal_remastered:obsidian_rune_host",
	"nether_portal_remastered:obsidian_rune_sentry",
	"nether_portal_remastered:obsidian_rune_shaper",
	"nether_portal_remastered:obsidian_rune_silence",
	"nether_portal_remastered:obsidian_rune_rib",
	"nether_portal_remastered:obsidian_rune_snout",
	"nether_portal_remastered:obsidian_rune_secret"

	#If true, vanilla obsidian portals will be blocked when a custom frame block is set.
	#Players will receive a message explaining the frame material is wrong.
	disableVanillaPortal = true
